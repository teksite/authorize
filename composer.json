{
    "name": "teksite/authorize",
    "description": "Authorization package for managing roles and permissions in Laravel applications",
    "authors": [
        {
            "name": "Sina Zangiband",
            "email": "sina.zangiband@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Teksite\\Authorize\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "extra": {
        "laravel": {
            "providers": [
              "\\Teksite\\Authorize\\AuthorizeServiceProvider"
            ]
        }
    }
}
